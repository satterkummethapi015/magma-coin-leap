<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/basalt_900">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide_art"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.52" />

    <ImageView
        android:id="@+id/menu_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toBottomOf="@id/guide_art"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/menu_fade"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/gradient_menu_fade"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="@id/guide_art"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/menu_explorer"
        android:layout_width="@dimen/sprite_explorer_menu"
        android:layout_height="@dimen/sprite_explorer_menu"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="18dp"
        android:contentDescription="@string/cd_explorer"
        android:scaleType="fitCenter"
        android:src="@drawable/sprite_explorer"
        app:layout_constraintBottom_toBottomOf="@id/guide_art"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/menu_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/status_bar_pad"
        android:paddingEnd="@dimen/screen_margin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/menu_best_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_token_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/menu_best_flag"
                android:layout_width="@dimen/flag_small"
                android:layout_height="@dimen/flag_small"
                android:contentDescription="@string/cd_flag"
                android:scaleType="fitCenter"
                android:src="@drawable/sprite_summit_flag" />

            <TextView
                android:id="@+id/menu_best_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.magmacoin.leap.core.ui.TokenBadgeView
            android:id="@+id/menu_token_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_sheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_sheet_basalt"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guide_art">

        <TextView
            android:id="@+id/menu_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="@string/menu_title"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menu_tagline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/menu_tagline"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <LinearLayout
            android:id="@+id/menu_stat_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.magmacoin.leap.core.ui.StatCardView
                android:id="@+id/menu_stat_best"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <com.magmacoin.leap.core.ui.StatCardView
                android:id="@+id/menu_stat_runs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/gap_s"
                android:layout_weight="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/menu_fresh_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.18"
            android:text="@string/menu_fresh_hint"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/menu_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="@string/menu_hint"
            android:textAppearance="@style/TextAppearance.App.Caption" />

        <FrameLayout
            android:id="@+id/menu_cta_wrap"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_primary_h"
            android:background="@drawable/bg_button_magma"
            android:elevation="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_play"
                style="@style/Widget.App.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/cta_play"
                app:icon="@drawable/ic_leap" />

        </FrameLayout>

        <LinearLayout
            android:id="@+id/menu_secondary_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_gear"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_secondary_h"
                android:layout_weight="1"
                android:text="@string/cta_gear_locker"
                app:icon="@drawable/ic_gear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_settings"
                style="@style/Widget.App.Button.Secondary"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_secondary_h"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/cta_settings"
                app:icon="@drawable/ic_settings" />

        </LinearLayout>

        <TextView
            android:id="@+id/menu_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/menu_footer"
            android:textAppearance="@style/TextAppearance.App.Micro" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
