<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/basalt_900">

    <ImageView
        android:id="@+id/splash_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/splash_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/gradient_splash_scrim"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/splash_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/gap_xl"
        android:paddingEnd="@dimen/gap_xl"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.40">

        <FrameLayout
            android:id="@+id/medallion_wrap"
            android:layout_width="@dimen/ember_ring_size"
            android:layout_height="@dimen/ember_ring_size">

            <ImageView
                android:id="@+id/ember_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_ember_ring" />

            <View
                android:id="@+id/mote_a"
                android:layout_width="@dimen/mote_size"
                android:layout_height="@dimen/mote_size"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="26dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_ember_mote"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/mote_b"
                android:layout_width="@dimen/mote_size"
                android:layout_height="@dimen/mote_size"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_ember_mote"
                android:importantForAccessibility="no" />

            <View
                android:id="@+id/mote_c"
                android:layout_width="@dimen/mote_size"
                android:layout_height="@dimen/mote_size"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="22dp"
                android:background="@drawable/bg_ember_mote"
                android:importantForAccessibility="no" />

            <FrameLayout
                android:id="@+id/medallion"
                android:layout_width="@dimen/medallion_size"
                android:layout_height="@dimen/medallion_size"
                android:layout_gravity="center"
                android:background="@drawable/bg_medallion_basalt">

                <ImageView
                    android:id="@+id/medallion_coin"
                    android:layout_width="@dimen/medallion_coin"
                    android:layout_height="@dimen/medallion_coin"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_coin"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_coin" />

            </FrameLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/splash_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center"
            android:shadowColor="@color/magma_500"
            android:shadowDy="2"
            android:shadowRadius="18"
            android:text="@string/splash_title"
            android:textAppearance="@style/TextAppearance.App.Display" />

        <TextView
            android:id="@+id/splash_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:letterSpacing="0.22"
            android:text="@string/splash_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/splash_progress"
            android:layout_width="@dimen/progress_w"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            android:indeterminate="true"
            app:indicatorColor="@color/magma_500"
            app:trackColor="@color/basalt_600"
            app:trackCornerRadius="3dp"
            app:trackThickness="5dp" />

        <TextView
            android:id="@+id/splash_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.2"
            android:text="@string/splash_progress_caption"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

    </LinearLayout>

    <TextView
        android:id="@+id/splash_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_splash_footer"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/splash_footer"
        android:textAppearance="@style/TextAppearance.App.Micro"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
